<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="calendar_event_view_list_lab" model="ir.ui.view">
        <field name="name">calendar.event.list.lab</field>
        <field name="model">calendar.event</field>
        <field name="priority">40</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="start"/>
                <field name="name"/>
                <field name="lab_contact_phone"/>
                <field name="lab_contact_email"/>
            </list>
        </field>
    </record>
    <record id="calendar_event_action_lab" model="ir.actions.act_window">
        <field name="name">Rendez-vous de prélèvement</field>
        <field name="res_model">calendar.event</field>
        <field name="view_mode">list,calendar,form</field>
        <field name="view_id" ref="calendar_event_view_list_lab"/>
        <field name="domain">[('lab_booking', '=', True)]</field>
        <field name="context">{'default_lab_booking': True}</field>
    </record>
    <menuitem id="menu_lab_booking" name="Rendez-vous" parent="lab_core.menu_lab_root"
              action="calendar_event_action_lab" sequence="15" groups="lab_core.group_lab_secretary"/>
</odoo>

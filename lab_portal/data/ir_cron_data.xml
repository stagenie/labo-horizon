<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_lab_remind" model="ir.cron">
        <field name="name">Labo : rappel par e-mail des rendez-vous du lendemain</field>
        <field name="model_id" ref="calendar.model_calendar_event"/>
        <field name="state">code</field>
        <field name="code">model._cron_lab_remind_tomorrow()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now() + relativedelta(days=1)).strftime('%Y-%m-%d 16:00:00')"/>
    </record>
</odoo>

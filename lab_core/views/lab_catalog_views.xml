<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="lab_analysis_view_list" model="ir.ui.view">
        <field name="name">lab.analysis.list</field>
        <field name="model">lab.analysis</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="sample_type"/>
                <field name="unit"/>
                <field name="ref_min"/>
                <field name="ref_max"/>
                <field name="ref_min_female" optional="hide"/>
                <field name="ref_max_female" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="lab_analysis_view_form" model="ir.ui.view">
        <field name="name">lab.analysis.form</field>
        <field name="model">lab.analysis</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Analyse">
                            <field name="code"/>
                            <field name="name"/>
                            <field name="sample_type"/>
                            <field name="unit"/>
                        </group>
                        <group string="Valeurs de référence">
                            <field name="ref_min"/>
                            <field name="ref_max"/>
                            <field name="ref_min_female"/>
                            <field name="ref_max_female"/>
                        </group>
                    </group>
                    <group>
                        <field name="protocol" filename="protocol_filename"/>
                        <field name="protocol_filename" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="lab_analysis_view_search" model="ir.ui.view">
        <field name="name">lab.analysis.search</field>
        <field name="model">lab.analysis</field>
        <field name="arch" type="xml">
            <search>
                <field name="code"/>
                <field name="name"/>
                <filter name="archived" string="Archivées" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>
    <record id="lab_analysis_action" model="ir.actions.act_window">
        <field name="name">Analyses</field>
        <field name="res_model">lab.analysis</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="lab_panel_view_list" model="ir.ui.view">
        <field name="name">lab.panel.list</field>
        <field name="model">lab.panel</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="analysis_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>
    <record id="lab_panel_view_form" model="ir.ui.view">
        <field name="name">lab.panel.form</field>
        <field name="model">lab.panel</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="analysis_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="lab_panel_action" model="ir.actions.act_window">
        <field name="name">Bilans</field>
        <field name="res_model">lab.panel</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

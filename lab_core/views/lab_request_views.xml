<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="lab_request_view_list" model="ir.ui.view">
        <field name="name">lab.request.list</field>
        <field name="model">lab.request</field>
        <field name="arch" type="xml">
            <list decoration-danger="abnormal_count > 0">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="prescriber_id"/>
                <field name="date_request"/>
                <field name="abnormal_count"/>
            </list>
        </field>
    </record>
    <record id="lab_request_view_form" model="ir.ui.view">
        <field name="name">lab.request.form</field>
        <field name="model">lab.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_load_panels" type="object" string="Charger les analyses des bilans" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <field name="patient_id"/>
                        <field name="patient_gender"/>
                        <field name="prescriber_id"/>
                        <field name="date_request"/>
                        <field name="panel_ids" widget="many2many_tags"/>
                    </group>
                    <field name="note" placeholder="Renseignements cliniques transmis par le prescripteur"/>
                    <notebook>
                        <page name="results" string="Résultats">
                            <field name="result_ids">
                                <list editable="bottom" decoration-danger="flag in ('low', 'high')">
                                    <field name="analysis_id"/>
                                    <field name="value_text"/>
                                    <field name="unit"/>
                                    <field name="range_min"/>
                                    <field name="range_max"/>
                                    <field name="flag"/>
                                </list>
                            </field>
                        </page>
                        <page name="samples" string="Tubes">
                            <field name="sample_ids">
                                <list editable="bottom">
                                    <field name="sample_type"/>
                                    <field name="collected_at"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="lab_request_action" model="ir.actions.act_window">
        <field name="name">Demandes</field>
        <field name="res_model">lab.request</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

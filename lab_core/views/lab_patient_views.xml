<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="lab_patient_view_list" model="ir.ui.view">
        <field name="name">lab.patient.list</field>
        <field name="model">lab.patient</field>
        <field name="arch" type="xml">
            <list>
                <field name="ref"/>
                <field name="name"/>
                <field name="birthdate"/>
                <field name="age"/>
                <field name="phone"/>
                <field name="gender"/>
                <field name="email"/>
                <field name="is_confidential" groups="lab_core.group_lab_biologist"/>
            </list>
        </field>
    </record>
    <record id="lab_patient_view_form" model="ir.ui.view">
        <field name="name">lab.patient.form</field>
        <field name="model">lab.patient</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <div class="text-muted"><field name="ref"/></div>
                        <h1><field name="name" placeholder="Nom du patient"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="birthdate"/>
                            <field name="age"/>
                            <field name="gender" widget="radio"/>
                        </group>
                        <group>
                            <field name="phone" widget="phone"/>
                            <field name="email" widget="email"/>
                            <field name="is_confidential" groups="lab_core.group_lab_biologist"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="requests" string="Demandes">
                            <field name="request_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="date_request"/>
                                    <field name="prescriber_id"/>
                                </list>
                            </field>
                        </page>
                        <page name="notes" string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="lab_patient_view_search" model="ir.ui.view">
        <field name="name">lab.patient.search</field>
        <field name="model">lab.patient</field>
        <field name="arch" type="xml">
            <search>
                <field name="ref"/>
                <field name="name"/>
                <field name="email"/>
                <filter name="female" string="Femmes" domain="[('gender', '=', 'female')]"/>
                <filter name="male" string="Hommes" domain="[('gender', '=', 'male')]"/>
                <group>
                    <filter name="group_gender" string="Sexe" context="{'group_by': 'gender'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="lab_patient_action" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="res_model">lab.patient</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

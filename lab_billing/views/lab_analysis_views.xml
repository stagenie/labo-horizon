<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="lab_analysis_view_list_billing" model="ir.ui.view">
        <field name="name">lab.analysis.list.billing</field>
        <field name="model">lab.analysis</field>
        <field name="inherit_id" ref="lab_core.lab_analysis_view_list"/>
        <field name="arch" type="xml">
            <field name="unit" position="after">
                <field name="price"/>
            </field>
        </field>
    </record>
    <record id="lab_analysis_view_form_billing" model="ir.ui.view">
        <field name="name">lab.analysis.form.billing</field>
        <field name="model">lab.analysis</field>
        <field name="inherit_id" ref="lab_core.lab_analysis_view_form"/>
        <field name="arch" type="xml">
            <field name="unit" position="after">
                <field name="price"/>
                <field name="product_id" invisible="not product_id"/>
            </field>
        </field>
    </record>
</odoo>

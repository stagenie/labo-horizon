<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_move_view_form_lab" model="ir.ui.view">
        <field name="name">account.move.form.lab</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@id='other_tab']" position="after">
                <page name="lab" string="Laboratoire" invisible="not lab_request_ids"
                      groups="lab_core.group_lab_secretary">
                    <field name="lab_request_ids">
                        <list>
                            <field name="name"/>
                            <field name="patient_id"/>
                            <field name="date_request"/>
                            <field name="state"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>

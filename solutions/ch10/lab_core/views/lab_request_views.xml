<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="lab_request_view_list" model="ir.ui.view">
        <field name="name">lab.request.list</field>
        <field name="model">lab.request</field>
        <field name="arch" type="xml">
            <list decoration-danger="abnormal_count > 0">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="prescriber_id"/>
                <field name="date_request"/>
                <field name="abnormal_count"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="lab_request_view_form" model="ir.ui.view">
        <field name="name">lab.request.form</field>
        <field name="model">lab.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_sample" type="object" string="Prélever" class="btn-primary" invisible="state != 'draft'"
                            groups="lab_core.group_lab_technician"/>
                    <button name="action_analyse" type="object" string="Terminer l'analyse" class="btn-primary"
                            invisible="state != 'sampled'" groups="lab_core.group_lab_technician"/>
                    <button name="action_validate" type="object" string="Valider" class="btn-primary"
                            invisible="state != 'analysed' or not can_validate"/>
                    <field name="can_validate" invisible="1"/>
                    <button name="action_reset_draft" type="object" string="Remettre en brouillon"
                            invisible="state in ('draft', 'validated')" groups="lab_core.group_lab_biologist"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <field name="patient_id" readonly="state != 'draft'"/>
                        <field name="patient_gender"/>
                        <field name="prescriber_id"/>
                        <field name="date_request"/>
                        <field name="panel_ids" widget="many2many_tags" readonly="state != 'draft'"/>
                    </group>
                    <field name="note" placeholder="Renseignements cliniques transmis par le prescripteur"/>
                    <notebook>
                        <page name="results" string="Résultats" groups="lab_core.group_lab_technician">
                            <field name="result_ids" readonly="state == 'validated'">
                                <list editable="bottom" decoration-danger="flag in ('low', 'high')">
                                    <field name="analysis_id"/>
                                    <field name="value_text"/>
                                    <field name="unit"/>
                                    <field name="range_min"/>
                                    <field name="range_max"/>
                                    <field name="flag"/>
                                </list>
                            </field>
                        </page>
                        <page name="samples" string="Tubes">
                            <field name="sample_ids">
                                <list editable="bottom">
                                    <field name="sample_type"/>
                                    <field name="barcode"/>
                                    <field name="collected_at"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="lab_request_view_kanban" model="ir.ui.view">
        <field name="name">lab.request.kanban</field>
        <field name="model">lab.request</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <templates>
                    <t t-name="card">
                        <field name="name" class="fw-bold"/>
                        <field name="patient_id"/>
                        <footer>
                            <field name="abnormal_count" invisible="not abnormal_count" class="text-danger"/>
                            <field name="activity_ids" widget="kanban_activity"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="lab_request_view_search" model="ir.ui.view">
        <field name="name">lab.request.search</field>
        <field name="model">lab.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="patient_id"/>
                <filter name="to_validate" string="À valider" domain="[('state', '=', 'analysed')]"/>
                <filter name="abnormal" string="Hors normes" domain="[('abnormal_count', '>', 0)]"/>
                <filter name="today" string="Aujourd'hui"
                        domain="[('date_request', '>=', context_today().strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter name="group_state" string="État" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="lab_request_view_calendar" model="ir.ui.view">
        <field name="name">lab.request.calendar</field>
        <field name="model">lab.request</field>
        <field name="arch" type="xml">
            <calendar date_start="date_request" mode="week" color="patient_id" event_open_popup="1">
                <field name="patient_id"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>
    <record id="lab_request_action" model="ir.actions.act_window">
        <field name="name">Demandes</field>
        <field name="res_model">lab.request</field>
        <field name="view_mode">kanban,list,form,calendar</field>
    </record>
</odoo>

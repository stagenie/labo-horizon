<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_lab_request" model="ir.actions.report">
        <field name="name">Compte rendu d'analyses</field>
        <field name="model">lab.request</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">lab_core.report_lab_request</field>
        <field name="print_report_name">'CR-%s-%s' % (object.patient_id.ref, object.name)</field>
        <field name="binding_model_id" ref="model_lab_request"/>
        <field name="binding_type">report</field>
        <field name="group_ids" eval="[Command.link(ref('lab_core.group_lab_technician'))]"/>
    </record>
</odoo>

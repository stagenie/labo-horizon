<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="lab_result_view_list_out_of_range" model="ir.ui.view">
        <field name="name">lab.result.list.out.of.range</field>
        <field name="model">lab.result</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <field name="request_id"/>
                <field name="analysis_id"/>
                <field name="value_text"/>
                <field name="unit"/>
                <field name="value" widget="lab_gauge" string="Position"/>
                <field name="flag"/>
            </list>
        </field>
    </record>

    <record id="lab_result_out_of_range_action" model="ir.actions.act_window">
        <field name="name">Résultats hors norme</field>
        <field name="res_model">lab.result</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="lab_result_view_list_out_of_range"/>
        <field name="domain">[('flag', 'in', ('low', 'high'))]</field>
    </record>

    <menuitem id="menu_lab_result_out_of_range" name="Résultats hors norme" parent="lab_core.menu_lab_root"
              action="lab_result_out_of_range_action" sequence="20" groups="lab_core.group_lab_technician"/>
</odoo>
